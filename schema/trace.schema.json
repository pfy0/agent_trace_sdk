{
  "$defs": {
    "MessageType": {
      "description": "消息类型枚举，取值与 message_id 缩写、role 的映射见 MESSAGE_TYPE_META。",
      "enum": [
        "system_prompt",
        "user_query",
        "reasoning",
        "tool_call",
        "tool_response",
        "final_answer"
      ],
      "title": "MessageType",
      "type": "string"
    },
    "Role": {
      "enum": [
        "system",
        "user",
        "assistant",
        "tool"
      ],
      "title": "Role",
      "type": "string"
    },
    "Status": {
      "enum": [
        "ok",
        "error",
        "cancelled"
      ],
      "title": "Status",
      "type": "string"
    },
    "Step": {
      "additionalProperties": true,
      "description": "轨迹中的一步 = `conversation` 数组里的一个元素。",
      "properties": {
        "message_id": {
          "description": "格式 msg_{类型缩写}_{序号}",
          "title": "Message Id",
          "type": "string"
        },
        "role": {
          "$ref": "#/$defs/Role"
        },
        "message_type": {
          "$ref": "#/$defs/MessageType"
        },
        "content": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "tool_call 时为 null",
          "title": "Content"
        },
        "timestamp": {
          "description": "ISO 8601 时间戳",
          "title": "Timestamp",
          "type": "string"
        },
        "step_no": {
          "anyOf": [
            {
              "minimum": 1,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "从 1 递增；由 SDK 统一分配",
          "title": "Step No"
        },
        "latency_ms": {
          "anyOf": [
            {
              "minimum": 0,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Latency Ms"
        },
        "is_follow_up": {
          "anyOf": [
            {
              "type": "boolean"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "仅 user_query 有意义；True 表示该轮内的追问/补充",
          "title": "Is Follow Up"
        },
        "tool_calls": {
          "anyOf": [
            {
              "items": {
                "$ref": "#/$defs/ToolCall"
              },
              "type": "array"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Tool Calls"
        },
        "tool_call_id": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Tool Call Id"
        },
        "span_id": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Span Id"
        },
        "parent_span_id": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Parent Span Id"
        },
        "status": {
          "anyOf": [
            {
              "$ref": "#/$defs/Status"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "error": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Error"
        },
        "input_tokens": {
          "anyOf": [
            {
              "minimum": 0,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Input Tokens"
        },
        "output_tokens": {
          "anyOf": [
            {
              "minimum": 0,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Output Tokens"
        },
        "model": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Model"
        },
        "tags": {
          "anyOf": [
            {
              "additionalProperties": {
                "type": "string"
              },
              "type": "object"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Tags"
        },
        "meta": {
          "anyOf": [
            {
              "additionalProperties": true,
              "type": "object"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Meta"
        }
      },
      "required": [
        "message_id",
        "role",
        "message_type",
        "timestamp"
      ],
      "title": "Step",
      "type": "object"
    },
    "ToolCall": {
      "additionalProperties": true,
      "description": "单个工具调用对象。字段刻意贴近 OpenAI 的 tool_calls 结构。",
      "properties": {
        "id": {
          "description": "工具调用 ID，用于与 tool_response 关联",
          "title": "Id",
          "type": "string"
        },
        "type": {
          "default": "function",
          "title": "Type",
          "type": "string"
        },
        "function": {
          "additionalProperties": true,
          "title": "Function",
          "type": "object"
        }
      },
      "required": [
        "id"
      ],
      "title": "ToolCall",
      "type": "object"
    }
  },
  "additionalProperties": true,
  "description": "一次 agent 运行 = 一个 turn = 一轮交互，是采集/校验/上报的基本单位。\n\n`turn_id` 由业务方传入，是 trace 的唯一标识（不再单独引入 trace_id）。\n`session_id` 同样由业务方传入，用于关联同一会话的多个 turn。",
  "properties": {
    "turn_id": {
      "description": "一轮交互的唯一标识，业务方传入",
      "minLength": 1,
      "title": "Turn Id",
      "type": "string"
    },
    "session_id": {
      "description": "会话标识，业务方传入",
      "minLength": 1,
      "title": "Session Id",
      "type": "string"
    },
    "agent_name": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Agent Name"
    },
    "agent_version": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Agent Version"
    },
    "env": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Env"
    },
    "started_at": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Started At"
    },
    "ended_at": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Ended At"
    },
    "duration_ms": {
      "anyOf": [
        {
          "minimum": 0,
          "type": "integer"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Duration Ms"
    },
    "status": {
      "anyOf": [
        {
          "$ref": "#/$defs/Status"
        },
        {
          "type": "null"
        }
      ],
      "default": null
    },
    "error": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Error"
    },
    "model": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Model"
    },
    "input_tokens": {
      "anyOf": [
        {
          "minimum": 0,
          "type": "integer"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Input Tokens"
    },
    "output_tokens": {
      "anyOf": [
        {
          "minimum": 0,
          "type": "integer"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Output Tokens"
    },
    "tags": {
      "anyOf": [
        {
          "additionalProperties": {
            "type": "string"
          },
          "type": "object"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Tags"
    },
    "meta": {
      "anyOf": [
        {
          "additionalProperties": true,
          "type": "object"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Meta"
    },
    "conversation": {
      "description": "该轮的全部步骤",
      "items": {
        "$ref": "#/$defs/Step"
      },
      "title": "Conversation",
      "type": "array"
    }
  },
  "required": [
    "turn_id",
    "session_id"
  ],
  "title": "AgentTrace",
  "type": "object",
  "$id": "https://github.com/pfy0/agent_trace_sdk/schema/trace.schema.json"
}
